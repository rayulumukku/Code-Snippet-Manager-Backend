# ─────────────────────────────────────────────────────────────
# Code Snippet Manager Backend - Environment Configuration
# ─────────────────────────────────────────────────────────────

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Connection String (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/code-snippet-manager?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate strong random 64-char keys)
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# Frontend Application Origin (for CORS and credentials)
FRONTEND_URL=https://codesnippetrayulu.vercel.app
